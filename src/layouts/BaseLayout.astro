---
interface Props {
  title: string;
  description?: string;
}

const { title, description = '논문 리뷰 모음 - 읽은 논문에 대한 종합 분석 보고서' } = Astro.props;
---

<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css"
  />
  <slot name="head" />
</head>
<body>
  <slot />
</body>
</html>
