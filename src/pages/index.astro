---
import BaseLayout from '../layouts/BaseLayout.astro';
import PaperSearch from '../components/PaperSearch';
import { getCollection } from 'astro:content';
import '../styles/index.css';

const reviewEntries = await getCollection('reviews');

const papers = reviewEntries
  .map((entry) => ({
    slug: entry.id,
    title: entry.data.title,
    originalTitle: entry.data.originalTitle,
    date: entry.data.date.toISOString().slice(0, 10),
    authors: entry.data.authors,
    institution: entry.data.institution,
    tags: entry.data.tags,
    description: entry.data.description,
  }))
  .sort((a, b) => b.date.localeCompare(a.date));
---

<BaseLayout title="Paper Review">
  <header class="site-header">
    <h1>Paper Review</h1>
    <p>읽은 논문에 대한 종합 분석 보고서 모음</p>
  </header>

  <PaperSearch client:load papers={papers} basePath={import.meta.env.BASE_URL} />

  <footer class="site-footer">
    Paper Review &copy; 2025
  </footer>
</BaseLayout>
